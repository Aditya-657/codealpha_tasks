<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FAQ AI Chatbot</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: linear-gradient(135deg, #eef2ff, #f8fafc);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.chatbot {
    width: 100%;
    max-width: 850px;
    height: 720px;
    background: white;
    border-radius: 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,.12);
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.header {
    background: linear-gradient(135deg, #4f46e5, #7c3aed);
    color: white;
    padding: 24px;
}

.header h1 {
    font-size: 25px;
    margin-bottom: 6px;
}

.header p {
    opacity: .9;
    font-size: 14px;
}

.status {
    margin-top: 10px;
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 7px;
}

.dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
}

.chat {
    flex: 1;
    padding: 24px;
    overflow-y: auto;
    background: #f8fafc;
}

.message {
    display: flex;
    margin-bottom: 16px;
}

.message.user {
    justify-content: flex-end;
}

.bubble {
    max-width: 75%;
    padding: 13px 16px;
    border-radius: 17px;
    line-height: 1.5;
    font-size: 15px;
}

.bot .bubble {
    background: white;
    border: 1px solid #e5e7eb;
    border-bottom-left-radius: 5px;
}

.user .bubble {
    background: #4f46e5;
    color: white;
    border-bottom-right-radius: 5px;
}

.suggestions {
    padding: 12px 20px;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    border-top: 1px solid #eee;
    background: white;
}

.suggestion {
    white-space: nowrap;
    border: 1px solid #d1d5db;
    background: white;
    border-radius: 20px;
    padding: 8px 13px;
    cursor: pointer;
    font-size: 12px;
}

.suggestion:hover {
    background: #eef2ff;
}

.input-area {
    padding: 18px;
    display: flex;
    gap: 10px;
    border-top: 1px solid #e5e7eb;
    background: white;
}

input {
    flex: 1;
    border: 1px solid #d1d5db;
    border-radius: 14px;
    padding: 14px 16px;
    outline: none;
    font-size: 15px;
}

input:focus {
    border-color: #6366f1;
}

button.send {
    border: 0;
    background: #4f46e5;
    color: white;
    border-radius: 14px;
    padding: 0 22px;
    cursor: pointer;
    font-weight: bold;
}

button.send:hover {
    background: #4338ca;
}

.typing {
    font-size: 13px;
    color: #6b7280;
    margin: 0 0 12px 4px;
    display: none;
}

@media(max-width:600px) {
    .chatbot {
        height: 90vh;
        border-radius: 16px;
    }

    .bubble {
        max-width: 88%;
    }

    .header {
        padding: 18px;
    }

    .chat {
        padding: 16px;
    }
}
</style>
</head>

<body>

<div class="chatbot">

    <div class="header">
        <h1>🤖 FAQ AI Chatbot</h1>
        <p>Ask a question and I'll find the most relevant FAQ answer.</p>

        <div class="status">
            <span class="dot"></span>
            Online • AI FAQ Assistant
        </div>
    </div>

    <div class="chat" id="chat">

        <div class="message bot">
            <div class="bubble">
                Hi! 👋 I'm your FAQ assistant.<br><br>

                Ask me about orders, payments, shipping,
                returns, refunds, accounts, or discounts.
            </div>
        </div>

    </div>

    <div class="typing" id="typing">
        Bot is thinking...
    </div>

    <div class="suggestions">

        <button class="suggestion"
                onclick="ask('How can I track my order?')">
            Track order
        </button>

        <button class="suggestion"
                onclick="ask('What is your return policy?')">
            Return policy
        </button>

        <button class="suggestion"
                onclick="ask('How long does shipping take?')">
            Shipping time
        </button>

        <button class="suggestion"
                onclick="ask('How can I get a refund?')">
            Refund
        </button>

        <button class="suggestion"
                onclick="ask('What payment methods do you accept?')">
            Payments
        </button>

    </div>

    <div class="input-area">

        <input
            id="question"
            type="text"
            placeholder="Type your question..."
            autocomplete="off"
        >

        <button class="send" onclick="sendMessage()">
            Send
        </button>

    </div>

</div>


<script>

const faqs = [

    {
        q: "How can I track my order?",
        a: "You can track your order from your account's Orders section. Open the order and select 'Track Order' to see the latest delivery status."
    },

    {
        q: "What is your return policy?",
        a: "You can request a return within 30 days of delivery. The product should normally be unused and in its original condition and packaging."
    },

    {
        q: "How long does shipping take?",
        a: "Standard shipping usually takes 3–7 business days. Delivery time can vary depending on your location and the product."
    },

    {
        q: "How can I get a refund?",
        a: "After an eligible return is approved, the refund is generally processed to your original payment method. Processing time depends on your bank or payment provider."
    },

    {
        q: "What payment methods do you accept?",
        a: "We accept major debit cards, credit cards, UPI, and other payment methods shown at checkout."
    },

    {
        q: "Can I cancel my order?",
        a: "Yes. You can cancel an order if it has not already entered the shipping process. Go to Orders and select the cancellation option."
    },

    {
        q: "Do you offer cash on delivery?",
        a: "Cash on Delivery may be available for selected products and locations. You can see whether COD is available during checkout."
    },

    {
        q: "How do I change my delivery address?",
        a: "If your order has not been shipped, contact support or use the address-edit option available in your order details."
    },

    {
        q: "How do I reset my password?",
        a: "Select 'Forgot Password' on the login page and follow the instructions sent to your registered email address."
    },

    {
        q: "Do you offer discounts?",
        a: "Yes. Available discounts and promotional offers are displayed on the product page, checkout page, or promotions section."
    },

    {
        q: "How can I contact customer support?",
        a: "You can contact customer support through the Help or Contact Us section of the website."
    },

    {
        q: "What should I do if my product arrives damaged?",
        a: "Take clear photos of the damaged product and packaging, then contact customer support as soon as possible to request assistance."
    }

];


// -----------------------------
// NLP PREPROCESSING
// -----------------------------

const stopWords = new Set([

    "a",
    "an",
    "the",
    "is",
    "are",
    "am",
    "to",
    "of",
    "in",
    "on",
    "for",
    "and",
    "or",
    "i",
    "me",
    "my",
    "we",
    "our",
    "you",
    "your",
    "can",
    "do",
    "does",
    "how",
    "what",
    "when",
    "where",
    "why",
    "with",
    "this",
    "that",
    "it",
    "be",
    "from",
    "about",
    "will",
    "would",
    "could",
    "should",
    "have",
    "has",
    "had",
    "please"

]);


function tokenize(text) {

    return text
        .toLowerCase()
        .replace(/[^a-z0-9\s]/g, " ")
        .split(/\s+/)
        .filter(word =>
            word && !stopWords.has(word)
        );

}


// -----------------------------
// WORD NORMALIZATION
// -----------------------------

function normalize(word) {

    if (word.length > 5 && word.endsWith("ing")) {
        return word.slice(0, -3);
    }

    if (word.length > 4 && word.endsWith("ed")) {
        return word.slice(0, -2);
    }

    if (word.length > 4 && word.endsWith("s")) {
        return word.slice(0, -1);
    }

    return word;
}


function processed(text) {

    return tokenize(text).map(normalize);

}


// -----------------------------
// TF-IDF
// -----------------------------

const documents =
    faqs.map(faq => processed(faq.q));


const vocabulary =
    [...new Set(documents.flat())];


const idf = {};


vocabulary.forEach(term => {

    const count =
        documents.filter(
            document => document.includes(term)
        ).length;

    idf[term] =
        Math.log(
            (documents.length + 1) /
            (count + 1)
        ) + 1;

});


function tfidf(tokens) {

    const counts = {};

    tokens.forEach(token => {

        counts[token] =
            (counts[token] || 0) + 1;

    });


    const vector = {};


    vocabulary.forEach(term => {

        const tf =
            counts[term]
            ? counts[term] / tokens.length
            : 0;

        vector[term] =
            tf * idf[term];

    });


    return vector;
}


// -----------------------------
// COSINE SIMILARITY
// -----------------------------

function cosineSimilarity(vector1, vector2) {

    let dot = 0;
    let magnitude1 = 0;
    let magnitude2 = 0;


    vocabulary.forEach(term => {

        dot +=
            vector1[term] *
            vector2[term];

        magnitude1 +=
            vector1[term] ** 2;

        magnitude2 +=
            vector2[term] ** 2;

    });


    if (!magnitude1 || !magnitude2) {
        return 0;
    }


    return dot /
        (
            Math.sqrt(magnitude1) *
            Math.sqrt(magnitude2)
        );

}


// Create vectors for FAQ questions

const faqVectors =
    documents.map(
        document => tfidf(document)
    );


// -----------------------------
// FIND BEST FAQ
// -----------------------------

function findBestFAQ(question) {

    const tokens =
        processed(question);


    if (tokens.length === 0) {
        return null;
    }


    const queryVector =
        tfidf(tokens);


    let bestIndex = 0;
    let bestScore = 0;


    faqVectors.forEach(
        (vector, index) => {

            const score =
                cosineSimilarity(
                    queryVector,
                    vector
                );


            if (score > bestScore) {

                bestScore = score;
                bestIndex = index;

            }

        }
    );


    if (bestScore < 0.15) {
        return null;
    }


    return {

        faq: faqs[bestIndex],

        score: bestScore

    };

}


// -----------------------------
// CHAT UI
// -----------------------------

function addMessage(text, type) {

    const chat =
        document.getElementById("chat");


    const message =
        document.createElement("div");


    message.className =
        "message " + type;


    const bubble =
        document.createElement("div");


    bubble.className =
        "bubble";


    bubble.textContent =
        text;


    message.appendChild(bubble);

    chat.appendChild(message);


    chat.scrollTop =
        chat.scrollHeight;

}


// -----------------------------
// SEND MESSAGE
// -----------------------------

function sendMessage() {

    const input =
        document.getElementById("question");


    const question =
        input.value.trim();


    if (!question) {
        return;
    }


    addMessage(
        question,
        "user"
    );


    input.value = "";


    document.getElementById(
        "typing"
    ).style.display = "block";


    setTimeout(() => {

        const result =
            findBestFAQ(question);


        document.getElementById(
            "typing"
        ).style.display = "none";


        if (result) {

            addMessage(
                result.faq.a,
                "bot"
            );

        } else {

            addMessage(
                "Sorry, I couldn't find a matching FAQ. Try asking about orders, shipping, returns, refunds, payments, discounts, or your account.",
                "bot"
            );

        }

    }, 500);

}


// -----------------------------
// SUGGESTION BUTTONS
// -----------------------------

function ask(text) {

    document.getElementById(
        "question"
    ).value = text;


    sendMessage();

}


// -----------------------------
// ENTER KEY
// -----------------------------

document
    .getElementById("question")
    .addEventListener(
        "keydown",
        function(event) {

            if (event.key === "Enter") {
                sendMessage();
            }

        }
    );

</script>

</body>
</html>